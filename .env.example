NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=replace-with-kakao-map-js-key
# 운영 배포에서만 true로 설정합니다. 로컬과 프리뷰 환경에서는 false를 유지합니다.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# HEIC 디코더 비교 실험: 개발 기본값 wasm, 배포 기본값 js. 비교할 때 js/wasm을 명시합니다.
# NEXT_PUBLIC_HEIC_PREVIEW_DECODER=wasm
